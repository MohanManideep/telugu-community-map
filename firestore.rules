rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // The map owner: the only one who can give or remove admin access.
    function isOwner() { return signedIn() && request.auth.uid == 'JtAaorFROTMYQrzw1PDMpYStQRK2'; }
    function isAdmin() {
      return isOwner() || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // ---------- family membership ----------
    // memberships/{uid} says which family a person belongs to ("" = none).
    // Accounts from before family members existed have no such document:
    // their family is the flag with their own user id.
    function memPath() { return /databases/$(database)/documents/memberships/$(request.auth.uid); }
    function famPath(f) { return /databases/$(database)/documents/families/$(f); }
    function isMember(f) {
      return signedIn() && f is string && f != ''
        && ((exists(memPath()) && get(memPath()).data.fam == f)
            || (!exists(memPath()) && f == request.auth.uid));
    }
    // The same, after this write (joining or creating a family in one step).
    function isMemberAfter(f) {
      return signedIn() && f is string && f != ''
        && ((existsAfter(memPath()) && getAfter(memPath()).data.fam == f)
            || (!existsAfter(memPath()) && f == request.auth.uid));
    }
    // The family's member list includes me after this write.
    function addsMe(f) {
      return existsAfter(famPath(f)) && request.auth.uid in getAfter(famPath(f)).data.get('people', {});
    }
    // A brand-new flag, with me as its only member. Its id is my user id, or "f_" plus random letters.
    function newFamily(f) {
      return (f == request.auth.uid || f.matches('f_[A-Za-z0-9]{16,40}'))
        && !exists(famPath(f)) && addsMe(f)
        && getAfter(famPath(f)).data.people.keys().hasOnly([request.auth.uid]);
    }
    function invPath(t) { return /databases/$(database)/documents/invites/$(t); }
    // Joining with an invite link: it must be valid, and it is used up in the same step.
    function viaInvite(d) {
      return 'via' in d && d.via is string && d.via.size() >= 16
        && exists(invPath(d.via))
        && get(invPath(d.via)).data.fam == d.fam
        && get(invPath(d.via)).data.expiresAt > request.time.toMillis()
        && !existsAfter(invPath(d.via))
        && addsMe(d.fam);
    }
    function joinPath() { return /databases/$(database)/documents/joins/$(request.auth.uid); }
    // Joining after the family accepted my request.
    function viaJoin(f) {
      return exists(joinPath())
        && get(joinPath()).data.fam == f
        && get(joinPath()).data.status == 'approved'
        && !existsAfter(joinPath())
        && addsMe(f);
    }

    // ---------- checks for stored data ----------
    function optStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }
    function optCount(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is int && d[k] >= 0 && d[k] <= max);
    }
    function validMessage(m) {
      return m == null || (
        m is map && m.keys().hasOnly(['text', 'days', 'postedAt', 'expiresAt'])
        && m.text is string && m.text.size() > 0 && m.text.size() <= 240
        && m.days is int && m.days >= 1 && m.days <= 14
        && m.postedAt is number && m.expiresAt is number
        && m.expiresAt <= m.postedAt + 15 * 86400000
      );
    }
    // Public part of a family's flag: everyone who is logged in can read it.
    function validFamily(d) {
      return d.keys().hasOnly(['name', 'lat', 'lng', 'address', 'profession', 'interests',
                               'members', 'kids', 'languages', 'about', 'contact',
                               'message', 'updatedAt', 'street', 'approx',
                               'locPublic', 'contactPublic', 'v', 'people'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.lat is number && d.lng is number
        && d.lat > 47 && d.lat < 55.5 && d.lng > 5.5 && d.lng < 15.5
        && optStr(d, 'address', 120) && optStr(d, 'street', 120)
        && optStr(d, 'profession', 80) && optStr(d, 'interests', 120)
        && optStr(d, 'about', 200) && optStr(d, 'contact', 80)
        && optCount(d, 'members', 20) && optCount(d, 'kids', 15)
        && (!('languages' in d) || (d.languages is list && d.languages.size() <= 10))
        && (!('message' in d) || validMessage(d.message))
        && (!('approx' in d) || d.approx is bool)
        && (!('locPublic' in d) || d.locPublic is bool)
        && (!('contactPublic' in d) || d.contactPublic is bool)
        // Members of the family and their first names, at most 6.
        && (!('people' in d) || (d.people is map && d.people.size() <= 6))
        // Never put hidden details into the public part.
        && (d.get('locPublic', true) == true || d.get('address', '') == '')
        && (d.get('contactPublic', true) == true || d.get('contact', '') == '')
        && d.updatedAt is number;
    }
    // Private part: exact position, full address, contact.
    function validPrivate(d) {
      return d.keys().hasOnly(['lat', 'lng', 'address', 'contact', 'dLat', 'dLng'])
        && d.lat is number && d.lng is number
        && optStr(d, 'address', 120) && optStr(d, 'contact', 80)
        && d.dLat is number && d.dLng is number
        && d.dLat < 0.01 && d.dLat > -0.01 && d.dLng < 0.01 && d.dLng > -0.01;
    }
    function accepted(path) {
      return exists(path) && get(path).data.status == 'accepted';
    }
    function connected(a, b) {
      return accepted(/databases/$(database)/documents/requests/$(a + '_' + b))
          || accepted(/databases/$(database)/documents/requests/$(b + '_' + a));
    }
    // My family is connected with this family.
    function connectedTo(owner) {
      return (exists(memPath()) && get(memPath()).data.fam != '' && connected(get(memPath()).data.fam, owner))
          || (!exists(memPath()) && connected(request.auth.uid, owner));
    }

    // ---------- families ----------
    // Everyone in a family can change its flag.
    match /families/{fid} {
      allow read: if signedIn();
      allow create: if (isMemberAfter(fid) || isAdmin()) && validFamily(request.resource.data);
      allow update: if (isMember(fid) || isMemberAfter(fid) || isAdmin()) && validFamily(request.resource.data);
      allow delete: if isMember(fid) || isAdmin();
    }

    // Only the family itself, connected families and the admins can read this.
    match /private/{fid} {
      allow read: if isMember(fid) || isAdmin() || connectedTo(fid);
      allow create, update: if (isMember(fid) || isMemberAfter(fid) || isAdmin())
        && validPrivate(request.resource.data);
      allow delete: if isMember(fid) || isAdmin();
    }

    // Which family each person belongs to.
    match /memberships/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['fam', 'at', 'via'])
        && request.resource.data.fam is string
        && request.resource.data.at is number
        && ((isAdmin() && request.resource.data.fam == '')
          || (request.auth.uid == uid
              && (request.resource.data.fam == ''
                  || newFamily(request.resource.data.fam)
                  || viaInvite(request.resource.data)
                  || viaJoin(request.resource.data.fam))));
      allow delete: if signedIn()
        && ((request.auth.uid == uid && !exists(famPath(uid))) || isAdmin());
    }

    // Invite links. The secret part of the link is the document id, so nobody can list them.
    match /invites/{token} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && token.size() >= 16
        && request.resource.data.keys().hasOnly(['fam', 'famName', 'by', 'byName', 'createdAt', 'expiresAt'])
        && isMember(request.resource.data.fam)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.famName is string && request.resource.data.famName.size() <= 40
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 30
        && request.resource.data.createdAt is number
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt <= request.time.toMillis() + 8 * 86400000;
      allow update: if false;
      allow delete: if signedIn()
        && (isMember(resource.data.fam) || isMemberAfter(resource.data.fam) || isAdmin());
    }

    // Asking to join a family. Document id is the person asking.
    match /joins/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isMember(resource.data.fam) || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fam', 'famName', 'name', 'fromName', 'status', 'createdAt'])
        && request.resource.data.fam is string
        && exists(famPath(request.resource.data.fam))
        && !isMember(request.resource.data.fam)
        && request.resource.data.famName is string && request.resource.data.famName.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is number;
      // Someone in that family answers, once.
      allow update: if signedIn()
        && isMember(resource.data.fam)
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status in ['approved', 'declined'];
      allow delete: if signedIn()
        && (request.auth.uid == uid || isMember(resource.data.fam) || isAdmin());
    }

    // ---------- connections between families ----------
    // Document id is "<from family>_<to family>". An admin without a family can also connect,
    // as the community admin: then "from" is their own user id.
    match /requests/{rid} {
      allow read: if signedIn()
        && (isMember(resource.data.from) || isMember(resource.data.to) || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'note', 'fromName', 'status', 'createdAt', 'asAdmin'])
        && request.resource.data.from is string
        && ((isMember(request.resource.data.from)
              && exists(famPath(request.resource.data.from))
              && !('asAdmin' in request.resource.data))
          || (request.resource.data.from == request.auth.uid && isAdmin()
              && request.resource.data.get('asAdmin', false) == true))
        && request.resource.data.to is string
        && request.resource.data.to != request.resource.data.from
        && rid == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40
        && request.resource.data.createdAt is number;
      // Only the receiving family answers, once.
      allow update: if signedIn()
        && isMember(resource.data.to)
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status in ['accepted', 'declined'];
      // Sender can cancel or remove a connection (but not erase a decline to ask again,
      // unless their flag is already gone); receiver can remove a connection or clear a decline.
      allow delete: if signedIn() && (
        ((isMember(resource.data.from) || resource.data.from == request.auth.uid)
          && (resource.data.status != 'declined' || !exists(famPath(resource.data.from))))
        || isMember(resource.data.to)
        || isAdmin());
    }

    // ---------- community posts: messages and events ----------
    function validPost(d) {
      return d.keys().hasOnly(['from', 'fromName', 'text', 'createdAt', 'expiresAt', 'isEvent', 'when', 'place', 'lat', 'lng', 'going', 'asAdmin'])
        // Only admins can post as "Community admin".
        && (!('asAdmin' in d) || d.asAdmin == false || (d.asAdmin == true && isAdmin()))
        && d.from is string
        && d.fromName is string && d.fromName.size() <= 40
        && d.text is string && d.text.size() > 0 && d.text.size() <= 400
        && d.createdAt is number && d.expiresAt is number
        && d.going is int && d.going >= 0
        && d.isEvent is bool
        && ((d.isEvent == true
              && d.when is number && d.place is string && d.place.size() > 0 && d.place.size() <= 120
              && d.expiresAt <= d.when + 2 * 86400000
              && d.when <= d.createdAt + 400 * 86400000)
          || (d.isEvent == false
              && d.expiresAt <= d.createdAt + 15 * 86400000))
        && (d.lat == null || (d.lat is number && d.lng is number
              && d.lat > 47 && d.lat < 55.5 && d.lng > 5.5 && d.lng < 15.5));
    }
    function postPath(pid) { return /databases/$(database)/documents/posts/$(pid); }
    function goingPath(pid, f) { return /databases/$(database)/documents/posts/$(pid)/going/$(f); }
    function goingStep(pid, f) {
      return (request.resource.data.going == resource.data.going + 1
                && !exists(goingPath(pid, f)) && existsAfter(goingPath(pid, f)))
          || (request.resource.data.going == resource.data.going - 1
                && exists(goingPath(pid, f)) && !existsAfter(goingPath(pid, f)));
    }
    // "I'm going" counts once per family (or per person without a family).
    function myGoingStep(pid) {
      return (exists(memPath()) && get(memPath()).data.fam != '' && goingStep(pid, get(memPath()).data.fam))
          || goingStep(pid, request.auth.uid);
    }
    match /posts/{pid} {
      allow read: if signedIn();
      // A family posts as itself; an admin can also post as "Community admin", even without a family.
      allow create: if signedIn()
        && request.resource.data.going == 0
        && validPost(request.resource.data)
        && ((request.resource.data.get('asAdmin', false) == true && isAdmin()
              && request.resource.data.from == request.auth.uid)
          || (request.resource.data.get('asAdmin', false) != true
              && isMember(request.resource.data.from)
              && exists(famPath(request.resource.data.from))));
      allow update: if signedIn() && (
        // The author edits their post; the "going" count stays as it is.
        ((isMember(resource.data.from) || resource.data.from == request.auth.uid)
          && request.resource.data.from == resource.data.from
          && request.resource.data.going == resource.data.going
          && validPost(request.resource.data))
        // Anyone taps "I'm going" or undoes it: the count moves by exactly 1, together with their own entry.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['going'])
          && myGoingStep(pid)));
      allow delete: if signedIn()
        && (isMember(resource.data.from) || resource.data.from == request.auth.uid || isAdmin());

      // Who is going: only that family, the organiser and the admins can see an entry.
      match /going/{gid} {
        allow read: if signedIn() && (isMember(gid) || gid == request.auth.uid
          || isMember(get(postPath(pid)).data.from)
          || get(postPath(pid)).data.from == request.auth.uid
          || isAdmin());
        allow create: if signedIn() && (isMember(gid) || gid == request.auth.uid)
          && request.resource.data.keys().hasOnly(['name', 'at'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.at is number
          && getAfter(postPath(pid)).data.going == get(postPath(pid)).data.going + 1;
        allow delete: if signedIn() && (
          ((isMember(gid) || gid == request.auth.uid)
            && getAfter(postPath(pid)).data.going == get(postPath(pid)).data.going - 1)
          || isMember(get(postPath(pid)).data.from)
          || get(postPath(pid)).data.from == request.auth.uid
          || isAdmin());
      }
    }

    // ---------- suggestions to the admins ----------
    // Members write their own; only the admins (and the writer) can read them.
    match /suggestions/{sid} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'email', 'type', 'text', 'status', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 60
        && request.resource.data.type in ['idea', 'problem', 'other']
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is number;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'seen', 'done'];
      allow delete: if isAdmin() || (signedIn() && resource.data.from == request.auth.uid);
    }

    // Which posts each person has already read (private to them).
    match /seen/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---------- admins ----------
    // Everyone logged in can see who they are. Only the owner gives admin access, never to themselves.
    // The owner can take it away, and an admin can give it up (for example when deleting their account).
    match /admins/{uid} {
      allow read: if signedIn();
      allow create: if isOwner() && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['role', 'name', 'addedAt'])
        && request.resource.data.role == 'admin'
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.addedAt is number
        && (exists(famPath(uid)) || exists(/databases/$(database)/documents/memberships/$(uid)));
      allow delete: if signedIn() && (isOwner() || request.auth.uid == uid);
      allow update: if false;
    }
  }
}
